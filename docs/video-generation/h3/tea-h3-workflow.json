{
  "type": "comfyui",
  "description": "使用自建 MiniMax H3 生成茶品牌分镜视频，包含原生声音。",
  "inputs": [
    {"key":"prompt","type":"string","required":true,"description":"生成要求"},
    {"key":"width","type":"number","required":true,"description":"宽度（像素）"},
    {"key":"height","type":"number","required":true,"description":"高度（像素）"},
    {"key":"length","type":"number","required":true,"description":"生成帧数（24 FPS）"},
    {"key":"seed","type":"number","required":true,"description":"随机种子"}
  ],
  "input_schema": {
    "type":"object","additionalProperties":false,"required":["prompt","width","height","length","seed"],
    "properties": {
      "prompt":{"type":"string","minLength":1,"maxLength":7000,"title":"生成要求"},
      "width":{"type":"integer","minimum":320,"maximum":1344,"multipleOf":32,"default":608,"title":"宽度（像素）"},
      "height":{"type":"integer","minimum":320,"maximum":768,"multipleOf":32,"default":352,"title":"高度（像素）"},
      "length":{"type":"integer","enum":[124,141,158,175,192,209,226,243,260,277,294,311,328,345,362],"default":124,"title":"生成帧数（24 FPS）"},
      "seed":{"type":"integer","minimum":0,"maximum":9007199254740991,"default":2026103101,"title":"随机种子"}
    }
  },
  "outputs":[{"key":"video","type":"video","media_type":"video/mp4","description":"分镜视频"}],
  "execution": {
    "node_id":"",
    "workflow_filename":"tea-h3-api.json",
    "input_bindings":[
      {"key":"prompt","node_id":"6","field_path":"prompt"},
      {"key":"width","node_id":"6","field_path":"width"},
      {"key":"height","node_id":"6","field_path":"height"},
      {"key":"length","node_id":"6","field_path":"length"},
      {"key":"seed","node_id":"8","field_path":"noise_seed"}
    ],
    "output_bindings":[{"key":"video","node_id":"15","index":0}],
    "workflow": {
      "1":{"class_type":"UNETLoader","inputs":{"unet_name":"minimax_h3_fl2va_pruned_w4a8_mixed.safetensors","weight_dtype":"default"}},
      "2":{"class_type":"CLIPLoader","inputs":{"clip_name":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors","type":"minimax","device":"default"}},
      "3":{"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_video_vae_fp16.safetensors"}},
      "4":{"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_audio_vae_fp32.safetensors"}},
      "5":{"class_type":"MiniMaxH3TurboLoRA","inputs":{"model":["1",0],"lora_name":"minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors","strength":1,"low_vram":true}},
      "6":{"class_type":"MiniMaxH3ImageToVideo","inputs":{"clip":["2",0],"vae":["3",0],"prompt":"清晨，薄雾缓缓流过中国山间茶园，露水覆盖嫩绿茶叶，远处群山层叠。一个连续远景镜头，摄像机极缓慢向前推进，柔和自然晨光，安静克制的茶品牌广告，真实摄影质感，无人物，无文字，无字幕。声音：轻柔鸟鸣、微风吹过茶叶，无对白，无配乐。","width":608,"height":352,"length":124}},
      "7":{"class_type":"BasicGuider","inputs":{"model":["5",0],"conditioning":["6",0]}},
      "8":{"class_type":"RandomNoise","inputs":{"noise_seed":2026103101}},
      "9":{"class_type":"MiniMaxH3TurboSampler","inputs":{}},
      "10":{"class_type":"BasicScheduler","inputs":{"model":["5",0],"scheduler":"simple","steps":4,"denoise":1}},
      "11":{"class_type":"SamplerCustomAdvanced","inputs":{"noise":["8",0],"guider":["7",0],"sampler":["9",0],"sigmas":["10",0],"latent_image":["6",1]}},
      "12":{"class_type":"VAEDecodeTiled","inputs":{"samples":["11",1],"vae":["3",0],"tile_size":256,"overlap":64,"temporal_size":16,"temporal_overlap":4}},
      "13":{"class_type":"VAEDecodeAudio","inputs":{"samples":["11",1],"vae":["4",0]}},
      "14":{"class_type":"CreateVideo","inputs":{"images":["12",0],"audio":["13",0],"fps":24}},
      "15":{"class_type":"SaveVideo","inputs":{"video":["14",0],"filename_prefix":"Pixoma/tea_h3_mountain","format":"mp4","codec":"h264"}}
    }
  }
}
