{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["../../../src/*"] },
    "ignoreDeprecations": "6.0"
  },
  "include": ["main.tsx", "composition.tsx", "media.ts", "model.mjs"]
}
